# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Endpoint OpenAI-compatible tùy biến. Bỏ trống để dùng api.openai.com.
# Command Code Provider API: https://api.commandcode.ai/provider/v1
# (khi đó OPENAI_API_KEY = key Command Code; embeddings phải dùng local, xem dưới)
OPENAI_BASE_URL=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Embedding riêng cho RAGAS evaluator: openai | sentence_transformers
# Đặt sentence_transformers khi endpoint LLM không có endpoint embeddings
# (ví dụ Command Code), để chấm bằng BAAI/bge-m3 chạy cục bộ.
EVALUATOR_EMBEDDING_PROVIDER=openai

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=

# Mở rộng viết tắt khi index: 1 = bật (mặc định), 0 = tắt.
# Dùng để đo A/B Recommendation #1: chạy baseline với 0 rồi candidate với 1.
GLOSSARY_EXPANSION=1
